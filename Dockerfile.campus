# 校园论坛专用镜像：在官方 NodeBB 镜像基础上，打包我们自己的插件
# 构建：docker build -f Dockerfile.campus -t nodebb-campus .

FROM node:22-bookworm-slim AS build

ENV NODE_ENV=production \
    DAEMON=false \
    SILENT=false

WORKDIR /usr/src/app/

COPY . /usr/src/app/

# NodeBB 的依赖清单放在 install/package.json，需要先复制到根目录
RUN cp /usr/src/app/install/package.json /usr/src/app/package.json \
    && npm install --omit=dev --no-audit --no-fund \
    && rm -rf /usr/src/app/.npm

# 把自定义插件放进 node_modules（Git 里是 plugins/ 目录，运行时必须在 node_modules 下）
RUN mkdir -p /usr/src/app/node_modules \
    && cp -r /usr/src/app/plugins/nodebb-plugin-campus-ai /usr/src/app/node_modules/ \
    && rm -rf /usr/src/app/node_modules/nodebb-plugin-campus-ai/node_modules

# 清掉不需要进镜像的东西
RUN rm -rf /usr/src/app/.git /usr/src/app/.github /usr/src/app/test

FROM node:22-bookworm-slim AS final

ENV NODE_ENV=production \
    DAEMON=false \
    SILENT=false

WORKDIR /usr/src/app/

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends install tini \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/src/app/logs /usr/src/app/build /usr/src/app/public/uploads /opt/config

COPY --from=build /usr/src/app/ /usr/src/app/

RUN chmod +x /usr/src/app/install/docker/entrypoint.sh

# 故意以 root 运行：云平台（Sealos / K8s）挂载的卷默认属于 root，
# 用普通用户会因为写不进挂载目录而启动失败。容器内 root 不影响宿主机安全。
# USER 不设置 → 默认 root

EXPOSE 4567

# 建议把这三个目录挂载为持久化存储
VOLUME ["/usr/src/app/build", "/usr/src/app/public/uploads", "/opt/config/"]

ENTRYPOINT ["tini", "--", "/usr/src/app/install/docker/entrypoint.sh"]
